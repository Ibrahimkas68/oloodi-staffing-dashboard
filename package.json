{
  "name": "oloodi-staffing-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "web",
    "e2e"
  ],
  "scripts": {
    "dev": "sh infra/scripts/dev.sh",
    "build": "npm run build -w @staffing/shared -w @staffing/web -w @staffing/server",
    "test": "npm run test -w @staffing/shared -w @staffing/server -w @staffing/web -w @staffing/e2e",
    "e2e": "npm run e2e -w @staffing/e2e",
    "e2e:docker": "sh infra/scripts/e2e-docker.sh",
    "measure": "npm run measure -w @staffing/e2e",
    "measure:docker": "sh infra/scripts/e2e-docker.sh measure",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:reset": "sh infra/scripts/reset-db.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
