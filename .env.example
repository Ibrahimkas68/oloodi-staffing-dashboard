# Copy to .env and adjust. Every variable has a working default for local development.
# Never commit .env.

# --- Database (PostgreSQL in Docker) ---
# Database name.
POSTGRES_DB=staffing
# Owner role: creates the schema and runs reset and seed. Used only by scripts.
POSTGRES_OWNER_USER=staffing_owner
POSTGRES_OWNER_PASSWORD=staffing_owner_dev
# Password for the least-privilege role the running app uses (staffing_app).
APP_DB_PASSWORD=staffing_app_dev
# Host port for Postgres, bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# --- Connection strings for running the server on this machine (npm run dev, tests) ---
# These repeat the passwords above (APP_DB_PASSWORD, POSTGRES_OWNER_PASSWORD) and must be kept in
# sync with them. A password containing @ : / breaks the URL; keep passwords to letters and digits.
# The app connects as staffing_app (no DDL, no DELETE, events append-only).
DATABASE_URL=postgres://staffing_app:staffing_app_dev@localhost:5432/staffing
# Scripts (reset, seed) connect as the owner.
DATABASE_OWNER_URL=postgres://staffing_owner:staffing_owner_dev@localhost:5432/staffing

# --- Server ---
# HTTP port of the API (and of the built web app in production).
PORT=3000
# true enables /api/demo/burst and /api/demo/outage. Keep false in production.
DEMO_MODE=false
# pino log level: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info
# Maximum concurrent live-update (SSE) connections; above it /api/events returns 503.
SSE_MAX_CLIENTS=100
# Requests per minute per client before the API answers 429.
RATE_LIMIT_PER_MINUTE=120
# Reverse proxies in front of the app (0 = none). The production compose file sets 1 for Caddy.
TRUST_PROXY=0
